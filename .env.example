# Stable 9router combo names. Change combo membership in 9router, not here.
ORCH_EXECUTION_COMBOS=OpenCode-Go,Kimi,OpenCode-Free
ORCH_PLANNER_MODEL=
ORCH_REVIEWER_MODEL=
ORCH_FORKS_PER_TICKET=3
ORCH_MAX_PARALLEL_TICKETS=1
ORCH_MAX_REPAIR_ROUNDS=2
ORCH_COMMAND_TIMEOUT_SECONDS=1800

# Optional infrastructure used by production workers and observability.
ORCH_REDIS_URL=redis://localhost:6379/0
ORCH_POSTGRES_DSN=postgresql://orchestrator:orchestrator@localhost:5432/orchestrator
LANGFUSE_HOST=http://localhost:3000

# Optional provider credentials for the Pull requests tab. Use the narrowest repository scope.
GH_TOKEN=
GITHUB_TOKEN=
GITLAB_TOKEN=
BITBUCKET_TOKEN=
# Set with BITBUCKET_TOKEN when the token is an app password that requires Basic authentication.
BITBUCKET_EMAIL=
